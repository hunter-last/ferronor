        this.idProveedor = idProveedor;
        this.idUsuarioSolicita = idUsuarioSolicita;
        this.estado = EstadoOrdenCompra.PENDIENTE;
    }

    public void agregarDetalle(DetalleOrdenCompra detalle) {
        detalles.add(detalle);
    }


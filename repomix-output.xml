        Connection cn = obtenerConexion();
        try (PreparedStatement ps = cn.prepareStatement(sql)) {
            ps.setInt(1, idRol);
            ps.setInt(2, idPermiso);
            ps.executeUpdate();
        } catch (SQLException e) {
            throw error("Error al asignar permiso al rol", e);
        } finally {
            cerrar(cn);
        }

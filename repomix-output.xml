CREATE INDEX idx_movimiento_fecha ON movimiento_inventario(fecha);
CREATE INDEX idx_movimiento_origen ON movimiento_inventario(origen);
CREATE INDEX idx_ajuste_producto ON ajuste_inventario(id_producto);


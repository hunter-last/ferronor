    private Categoria mapear(ResultSet rs) throws SQLException {
        Categoria c = new Categoria(rs.getString("nombre"));
        c.setIdCategoria(rs.getInt("id_categoria"));
        return c;
    }
    
        @Override
    public List<Categoria> buscarPorNombreParcial(String texto) {

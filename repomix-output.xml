                rolDAO,
                auditoriaService
        );

        LoginServiceImpl loginService = new LoginServiceImpl(
                usuarioDAO,
                rolDAO,
                permisoDAO,
                auditoriaService
        );

        try (TransactionContext tx = TransactionManager.iniciar()) {

            RespuestaOperacion<Void> loginAdmin
                    = loginService.iniciarSesion("admin", "12345678");

